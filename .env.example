# ==============================================================================
# GuardianAI Master Project Root Environment Variable Template
# Purpose: Unified template for local development, docker-compose, and CI environment setup.
# ==============================================================================

# Backend Application Configuration
PROJECT_NAME="GuardianAI"
ENVIRONMENT="development" # Options: development, staging, production
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Security & Cryptography
SECRET_KEY="dev_secret_key_change_in_production_environment_32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite for dev; PostgreSQL for production)
DATABASE_URL="sqlite:///./guardianai.db"

# CORS Whitelist Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Rate Limiting & Storage
RATE_LIMIT_PER_MINUTE=60
UPLOAD_FOLDER="./uploads"

# Logging & Telemetry
LOG_LEVEL="INFO"
ENABLE_TELEMETRY=true

# AI Provider Placeholders (Do NOT commit real secret keys)
GEMINI_API_KEY="your-gemini-api-key-placeholder"
GROQ_API_KEY="your-groq-api-key-placeholder"
HUGGINGFACE_API_KEY="your-huggingface-api-key-placeholder"
VIRUSTOTAL_API_KEY="your-virustotal-api-key-placeholder"

# Frontend Specific Variables
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_APP_TITLE="GuardianAI - Explainable Anti-Scam Protection"

# Future Extension & Integration Placeholders
OCR_ENGINE_PROVIDER="local_tesseract"
VOICE_SPEECH_TO_TEXT_PROVIDER="local_whisper"
BROWSER_EXTENSION_ALLOWED_IDS="ext_chrome_placeholder_id,ext_firefox_placeholder_id"

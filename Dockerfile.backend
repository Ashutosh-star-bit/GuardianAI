# GuardianAI Multi-Stage Backend Dockerfile
# Purpose: Supports Python 3.12 FastAPI backend for development and secure non-root production deployment.

# ------------------------------------------------------------------------------
# Stage 1: Base Python Environment
# ------------------------------------------------------------------------------
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Development Target
# ------------------------------------------------------------------------------
FROM base AS development
ENV ENVIRONMENT=development
COPY backend /app/backend
WORKDIR /app/backend
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]

# ------------------------------------------------------------------------------
# Stage 3: Production Target (Non-Root User Security)
# ------------------------------------------------------------------------------
FROM base AS production
ENV ENVIRONMENT=production

# Create non-root app user for container security hardening
RUN addgroup --system appgroup && adduser --system --group appuser

COPY backend /app/backend
WORKDIR /app/backend

# Create uploads and logs directories with correct permissions
RUN mkdir -p /app/backend/uploads /app/backend/logs \
    && chown -R appuser:appgroup /app/backend

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

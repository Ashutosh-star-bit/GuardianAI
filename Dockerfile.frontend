# GuardianAI Multi-Stage Frontend Dockerfile
# Purpose: Supports both local development (Vite dev server) and production (Nginx alpine static host).

# ------------------------------------------------------------------------------
# Stage 1: Dependency & Base Stage
# ------------------------------------------------------------------------------
FROM node:20-alpine AS base
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

# ------------------------------------------------------------------------------
# Stage 2: Development Stage (Vite Dev Server)
# ------------------------------------------------------------------------------
FROM base AS development
ENV NODE_ENV=development
COPY frontend/ ./
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]

# ------------------------------------------------------------------------------
# Stage 3: Production Builder Stage
# ------------------------------------------------------------------------------
FROM base AS builder
COPY frontend/ ./
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 4: Production Stage (Nginx Alpine Web Server)
# ------------------------------------------------------------------------------
FROM nginx:1.25-alpine AS production
# Copy compiled static assets from builder stage
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

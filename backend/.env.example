# ==============================================================================
# GuardianAI Backend Master Environment Configuration Template
# Purpose: Defines configuration settings for Python 3.12 FastAPI backend, SQLAlchemy ORM,
#          JWT authentication, Gemini AI engine, rate limiting, and future extension integrations.
# Security: DO NOT store actual secrets in version control. Copy to .env for local usage.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment Metadata
# ------------------------------------------------------------------------------
# PROJECT_NAME: Display name of the SaaS platform
PROJECT_NAME="GuardianAI"

# ENVIRONMENT: Execution mode (Options: development, staging, production)
# Controls error traceback verbosity and strict security enforcement
ENVIRONMENT="development"

# DEBUG: Toggles detailed FastAPI debug logs and SQLAlchemy query echoing (true/false)
DEBUG=true

# API_V1_STR: API version prefix for endpoint routing
API_V1_STR="/api/v1"

# HOST & PORT: Uvicorn server host binding and listening port
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# DATABASE_URL: Connection string for database (SQLite for dev; PostgreSQL for prod)
# SQLite dev example: sqlite:///./guardianai.db
# PostgreSQL prod example: postgresql://postgres:password@localhost:5432/guardianai
DATABASE_URL="sqlite:///./guardianai.db"

# DB_POOL_SIZE: Maximum persistent database connections in pool (PostgreSQL)
DB_POOL_SIZE=5

# DB_MAX_OVERFLOW: Maximum temporary connections above pool size during traffic spikes
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------------------
# 3. Security & Cryptography (JWT & Hashing)
# ------------------------------------------------------------------------------
# SECRET_KEY: Master 256-bit secret used to sign JWT access tokens (Minimum 32 chars)
# Security Warning: CHANGE THIS TO A UNIQUE SECURE RANDOM STRING IN PRODUCTION
SECRET_KEY="dev_secret_key_change_in_production_environment_32chars"

# ALGORITHM: Cryptographic signing algorithm for JWT tokens (HS256 or RS256)
ALGORITHM="HS256"

# ACCESS_TOKEN_EXPIRE_MINUTES: Lifetime of JWT access token before renewal (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15

# REFRESH_TOKEN_EXPIRE_DAYS: Lifetime of JWT refresh token (in days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. CORS Whitelist Configuration
# ------------------------------------------------------------------------------
# CORS_ORIGINS: Comma-separated list of allowed frontend origins permitted to make API requests
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Storage Limits
# ------------------------------------------------------------------------------
# RATE_LIMIT_PER_MINUTE: Maximum allowed requests per minute per IP for free tier users
RATE_LIMIT_PER_MINUTE=60

# UPLOAD_FOLDER: Local directory path for temporary file uploads (.eml, images)
UPLOAD_FOLDER="./uploads"

# MAX_UPLOAD_SIZE_MB: Maximum allowed file upload payload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Logging Configuration
# ------------------------------------------------------------------------------
# LOG_LEVEL: Application logging verbosity (Options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 7. AI Engine Integrations (Gemini & Fallbacks)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Primary API key for Google Gemini 1.5 Pro / Flash XAI inference engine
GEMINI_API_KEY="your-gemini-api-key-placeholder"

# GROQ_API_KEY: Fallback high-speed Tier 1 LLM inference provider key (Llama-3)
GROQ_API_KEY="your-groq-api-key-placeholder"

# HUGGINGFACE_API_KEY: Fallback Tier 2 Hugging Face Inference API key
HUGGINGFACE_API_KEY="your-huggingface-api-key-placeholder"

# VIRUSTOTAL_API_KEY: Threat intelligence lookup key for domain & file hash inspection
VIRUSTOTAL_API_KEY="your-virustotal-api-key-placeholder"

# ------------------------------------------------------------------------------
# 8. Analytics & Telemetry Configuration
# ------------------------------------------------------------------------------
# ENABLE_TELEMETRY: Toggles anonymized threat telemetry logging (true/false)
ENABLE_TELEMETRY=true

# TELEMETRY_BATCH_SIZE: Number of anonymized scan events before flushing to analytics
TELEMETRY_BATCH_SIZE=20

# ------------------------------------------------------------------------------
# 9. Future Integrations Placeholders (OCR, Voice, Browser Extension)
# ------------------------------------------------------------------------------
# OCR_ENGINE_PROVIDER: Provider for image text extraction (Options: local_tesseract, google_vision)
OCR_ENGINE_PROVIDER="local_tesseract"

# VOICE_SPEECH_TO_TEXT_PROVIDER: Provider for phone scam audio transcriptions (Options: local_whisper, deepgram)
VOICE_SPEECH_TO_TEXT_PROVIDER="local_whisper"

# BROWSER_EXTENSION_ALLOWED_IDS: Comma-separated list of authorized Chrome/Firefox Extension IDs
BROWSER_EXTENSION_ALLOWED_IDS="ext_chrome_placeholder_id,ext_firefox_placeholder_id"

# WEBSOCKET_REALTIME_ENABLED: Toggles real-time streaming scans over WebSockets (true/false)
WEBSOCKET_REALTIME_ENABLED=false

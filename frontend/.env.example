# ==============================================================================
# GuardianAI Frontend Environment Configuration Template
# Purpose: Defines client-side environment variables exposed to Vite (`import.meta.env`).
# Security Note: ONLY variables prefixed with `VITE_` are bundled into frontend client JS.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Service Endpoint Configuration
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: Base URL for GuardianAI FastAPI backend service
# Development local proxy target: http://localhost:8000/api/v1
# Production target: https://api.guardianai.com/api/v1
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# ------------------------------------------------------------------------------
# 2. Application & Branding Metadata
# ------------------------------------------------------------------------------
# VITE_APP_TITLE: Title displayed in browser tab and top navbar header
VITE_APP_TITLE="GuardianAI - Explainable Anti-Scam Protection"

# VITE_APP_VERSION: Client application release version
VITE_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 3. Client Feature Flags & Accessibility Options
# ------------------------------------------------------------------------------
# VITE_ENABLE_SENIOR_MODE_DEFAULT: Toggles whether Senior Mode starts ON by default (true/false)
VITE_ENABLE_SENIOR_MODE_DEFAULT=false

# VITE_ENABLE_CLIENT_PII_SCRUBBING: Toggles local Web Worker PII scrubbing before API dispatch (true/false)
VITE_ENABLE_CLIENT_PII_SCRUBBING=true

# ------------------------------------------------------------------------------
# 4. Analytics & Telemetry Placeholders
# ------------------------------------------------------------------------------
# VITE_ENABLE_ANALYTICS: Toggles anonymized UX telemetry collection (true/false)
VITE_ENABLE_ANALYTICS=false

# VITE_ANALYTICS_WRITE_KEY: Placeholder client key for PostHog or Segment analytics
VITE_ANALYTICS_WRITE_KEY="ph_client_key_placeholder"

# ------------------------------------------------------------------------------
# 5. Future Browser Extension & Voice Placeholders
# ------------------------------------------------------------------------------
# VITE_EXTENSION_MODE: Toggles browser extension popup layout compact mode (true/false)
VITE_EXTENSION_MODE=false

# VITE_ENABLE_VOICE_NARRATION: Enables Web Speech API text-to-speech audio narration (true/false)
VITE_ENABLE_VOICE_NARRATION=true

# VITE_OCR_CLIENT_ENABLED: Toggles client-side Tesseract.js OCR preprocessing (true/false)
VITE_OCR_CLIENT_ENABLED=false

# ==============================================================================
# GuardianAI Frontend Production Dockerfile (Multi-Stage Build)
# Stage 1: Builder (Node 20 Alpine)
# Stage 2: Runner (Nginx Alpine Unprivileged)
# Target Image Size: < 35 MB
# ==============================================================================

# STAGE 1: Build static bundle
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency manifests
COPY package.json package-lock.json ./
RUN npm ci --prefer-offline --no-audit

# Copy source code and build Vite bundle
COPY . .
RUN npm run build

# STAGE 2: Serve via Lightweight Production Nginx Engine
FROM nginx:1.25-alpine AS runner

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy compiled static bundle from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Security Hardening: Non-root execution
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /usr/share/nginx/html

USER nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]

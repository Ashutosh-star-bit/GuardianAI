{
  "name": "guardianai-root",
  "version": "1.0.0",
  "private": true,
  "description": "GuardianAI Monorepo / Multi-Package Root Configuration & Scripts",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "python scripts/dev.py",
    "dev:backend": "cd backend && uvicorn main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "lint": "npm run lint:frontend",
    "lint:frontend": "cd frontend && npm run lint",
    "test": "npm run test:frontend",
    "test:frontend": "cd frontend && npm run test",
    "docker:up": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "anti-scam",
    "explainable-ai",
    "cybersecurity",
    "privacy-first"
  ],
  "author": "GuardianAI Engineering Team",
  "license": "UNLICENSED"
}
